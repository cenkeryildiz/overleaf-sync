+/* Optional browser transport reuses the authoritative MuPDF display list. */
+static void export_frame(struct persistent_state *ps, ui_state *ui, fz_display_list *dl)
+{
+  const char *dir = getenv("TEXPRESSO_FRAME_DIR");
+  static unsigned long serial = 0;
+  if (!dir || !*dir || !browser_pending || need_advance(ps->ctx, ui)) return;
+  if (dvi_missing_font) { printf("[\"frame-error\",%d]\n", browser_revision); fflush(stdout); return; }
+  char png[4096], json[4096];
+  unsigned long id = ++serial;
+  if (snprintf(png, sizeof(png), "%s/%lu.png", dir, id) >= sizeof(png) ||
+      snprintf(json, sizeof(json), "%s/%lu.json", dir, id) >= sizeof(json)) return;
+  fz_pixmap *pix = NULL;
+  fz_stext_page *text = NULL;
+  fz_output *out = NULL;
+  fz_var(pix); fz_var(text); fz_var(out);
+  fz_try(ps->ctx)
+  {
+    pix = fz_new_pixmap_from_display_list(ps->ctx, dl, fz_identity,
+                                        fz_device_rgb(ps->ctx), 0);
+    fz_save_pixmap_as_png(ps->ctx, pix, png);
+    text = fz_new_stext_page_from_display_list(ps->ctx, dl, NULL);
+    out = fz_new_output_with_path(ps->ctx, json, 0);
+    fz_print_stext_page_as_json(ps->ctx, out, text, 1);
+    fz_close_output(ps->ctx, out);
+    printf("[\"frame\",%lu,%d,%d,%d,%d,%d]\n", id, ui->page,
+           fz_pixmap_width(ps->ctx, pix), fz_pixmap_height(ps->ctx, pix),
+           send(page_count, ui->eng), browser_revision);
+    fflush(stdout);
+    browser_pending = false;
+  }
+  fz_always(ps->ctx)
+  {
+    fz_drop_output(ps->ctx, out);
+    fz_drop_stext_page(ps->ctx, text);
+    fz_drop_pixmap(ps->ctx, pix);
+  }
+  fz_catch(ps->ctx)
+  {
+    unlink(png); unlink(json);
+    fprintf(stderr, "[frame] export failed: %s\n", fz_caught_message(ps->ctx));
+  }
+}
