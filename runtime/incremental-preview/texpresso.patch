+/* Load the actual pdfTeX-embedded bitmap font through MuPDF's PDF machinery. */
+static void load_bitmap_font(fz_context *ctx, dvi_resmanager *rm, dvi_font *font)
+{
+  const char *dir = getenv("TEXPRESSO_BITMAP_FONTS");
+  if (!dir || !*font->name || strlen(font->name) > 64 ||
+      strspn(font->name, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_") != strlen(font->name)) return;
+  char filename[4096];
+  if (snprintf(filename, sizeof(filename), "%s/%s.pdf", dir, font->name) >= sizeof(filename) || access(filename, R_OK)) return;
+  pdf_font_desc *desc = NULL;
+  fz_var(desc);
+  fz_try(ctx)
+  {
+    pdf_document *doc = dvi_resmanager_get_pdf(ctx, rm, filename);
+    if (!doc) fz_throw(ctx, FZ_ERROR_GENERIC, "bitmap font PDF unavailable");
+    pdf_obj *page = pdf_lookup_page_obj(ctx, doc, 0);
+    pdf_obj *resources = pdf_dict_get_inheritable(ctx, page, PDF_NAME(Resources));
+    pdf_obj *fonts = pdf_dict_get(ctx, resources, PDF_NAME(Font));
+    if (pdf_dict_len(ctx, fonts) != 1) fz_throw(ctx, FZ_ERROR_GENERIC, "bitmap font PDF must contain one font");
+    pdf_obj *object = pdf_dict_get_val(ctx, fonts, 0);
+    if (!pdf_name_eq(ctx, pdf_dict_get(ctx, object, PDF_NAME(Subtype)), PDF_NAME(Type3)))
+      fz_throw(ctx, FZ_ERROR_GENERIC, "bitmap resource is not Type3");
+    desc = pdf_load_font(ctx, doc, resources, object);
+    int *map = fz_malloc_array(ctx, 256, int);
+    for (int c = 0; c < 256; ++c)
+      map[c] = pdf_font_cid_to_gid(ctx, desc, pdf_lookup_cmap(desc->encoding, c));
+    font->fz = fz_keep_font(ctx, desc->font);
+    font->glyph_map = map;
+  }
+  fz_always(ctx) { pdf_drop_font(ctx, desc); }
+  fz_catch(ctx) { fz_warn(ctx, "bitmap font resource rejected: %s", fz_caught_message(ctx)); }
+}
