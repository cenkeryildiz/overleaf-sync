# Copy to a private .env (mode0600); never commit populated credentials.
OVERLEAF_SITE_URL=https://latex.example.com
OVERLEAF_INVITE_TOKEN_SECRET=REPLACE_WITH_RANDOM_HEX_64
OVERLEAF_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX_64
LATEX_PORT=8080

# Google is a first-publication requirement. Register the exact callback:
# https://latex.example.com/oidc/login/callback
# For isolated local testing only, set SITE_URL=http://127.0.0.1:8081
# and register http://127.0.0.1:8081/oidc/login/callback instead.
EXTERNAL_AUTH=oidc
OVERLEAF_OIDC_PROVIDER_ID=google
OVERLEAF_OIDC_PROVIDER_NAME=Google
OVERLEAF_OIDC_IDENTITY_SERVICE_NAME=Continue with Google
OVERLEAF_OIDC_ISSUER=https://accounts.google.com
OVERLEAF_OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OVERLEAF_OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
OVERLEAF_OIDC_USER_INFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OVERLEAF_OIDC_USER_ID_FIELD=id
OVERLEAF_OIDC_SCOPE=openid profile email
OVERLEAF_OIDC_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
OVERLEAF_OIDC_CLIENT_SECRET=REPLACE_IN_PRIVATE_CONFIGURATION
