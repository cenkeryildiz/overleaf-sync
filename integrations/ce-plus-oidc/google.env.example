# Not active. Fill a private copy before adding these settings to Toolkit config/variables.env.
# Register this exact redirect URI in a Google web OAuth client:
# http://127.0.0.1:8080/oidc/login/callback
OVERLEAF_SITE_URL=http://127.0.0.1:8080
EXTERNAL_AUTH=oidc
OVERLEAF_OIDC_PROVIDER_ID=google
OVERLEAF_OIDC_PROVIDER_NAME=Google
OVERLEAF_OIDC_IDENTITY_SERVICE_NAME=Continue with Google
OVERLEAF_OIDC_ISSUER=https://accounts.google.com
OVERLEAF_OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OVERLEAF_OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
OVERLEAF_OIDC_USER_INFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OVERLEAF_OIDC_USER_ID_FIELD=id
OVERLEAF_OIDC_SCOPE=openid profile email
OVERLEAF_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
OVERLEAF_OIDC_CLIENT_SECRET=REPLACE_IN_PRIVATE_CONFIGURATION
# Local application logout is intentional; do not configure a Google logout endpoint.
